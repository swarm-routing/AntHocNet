// AntHocNet devcontainer (#334) — clone to a running simulation in one click,
// in GitHub Codespaces or local VS Code ("Dev Containers: Reopen in Container").
//
// Nothing is built from scratch here: we start from the org's ns-3 image
// (ghcr.io/swarm-routing/ns3-dev, built by swarm-routing/ns3-containers), which
// carries a configured, built stock ns-3 tree at /opt/ns-3. post-create.sh then
// installs the AntHocNet modules *from this checkout* and builds them with the
// image's own profile flags, so only the AntHocNet delta compiles (~80 Ninja
// steps, no stock object; not the ~15 min a fresh ns-3 build costs).
//
// devcontainer.json is JSONC: `//` comments are part of the format and are
// accepted by the Dev Containers spec, Codespaces and the devcontainer CLI.
{
  "name": "AntHocNet (ns-3.48 debug)",

  // Image choice: ns3-dev:3.48-debug, pinned by digest.
  //
  //   * ns-3 3.48, as CI's gate leg (ci.yml / ci-ns3.yml gate-version): ns-3.49's
  //     stock AODV and the vendored AOMDV livelock (#843), and most comparisons
  //     here run an AODV-family arm. When #843 closes and CI moves back to
  //     `latest`, move this to `latest-debug` (its digest) with it.
  //   * debug profile: asserts and NS_LOG on, which is what development wants
  //     (CI's build legs use the plain `default` tag; numbers for publication
  //     come from the campaign images, never from here).
  //   * pinned by digest, the tag in the comment: `3.48-debug` is a rolling tag
  //     (ns3-containers rebuilds it on package refreshes), and a Codespace made
  //     a month apart from the same commit should get the same toolchain.
  //
  // Bumping is manual: Dependabot's docker ecosystem covers /docker only
  // (.github/dependabot.yml) and does not read devcontainer.json. Resolve a new
  // digest with `docker pull ghcr.io/swarm-routing/ns3-dev:<tag>` then
  // `docker inspect --format '{{index .RepoDigests 0}}' ghcr.io/swarm-routing/ns3-dev:<tag>`.
  // ghcr.io/swarm-routing/ns3-dev:3.48-debug
  "image": "ghcr.io/swarm-routing/ns3-dev@sha256:d81ec51cd842c1fcae85f82c55973615cdde4c7a477c831897d62a6fdb62c2c2",

  // The image's ns-3 tree. Everything (the Makefile installer, the ns3 wrapper,
  // the docs) refers to it by path; exporting it means the commands in
  // ns3/README.md and AGENTS.md can be copy-pasted verbatim inside the container.
  "containerEnv": {
    "NS3DIR": "/opt/ns-3"
  },

  // The image defines no non-root user and /opt/ns-3 is root-owned, so the
  // rebuild in post-create.sh needs root. Stated explicitly rather than relying
  // on the implicit "inherit the image's user" default.
  "remoteUser": "root",

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      // Deliberately three: what the repo is actually written in. C/C++ for
      // core/ + the ns-3 adapter, CMake for core/'s build (and ns-3's), Python
      // for ns3/tools/*.py (the scenario runner and chart/benchmark scripts).
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python"
      ]
    }
  }
}
