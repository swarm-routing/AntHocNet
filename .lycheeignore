# External link check (#646): hosts that refuse or throttle bots, so a
# "failure" there says nothing about the link. One regex per line.
^https://doi\.org/10\.1145/
^https://dl\.acm\.org/
^https://ieeexplore\.ieee\.org/
^https://www\.sciencedirect\.com/
^https://link\.springer\.com/
^https://onlinelibrary\.wiley\.com/
^https://www\.researchgate\.net/
^https://scholar\.google\.com/
# Placeholders and local addresses used in examples.
^https?://(localhost|127\.0\.0\.1)
^https://claude\.ai/
# Open copy of the BeeAdHoc GECCO 2005 paper (its DOI is cited beside it). The
# host times out from GitHub's runners (2026-10-28, 2026-11-11, three retries
# of 30 s) yet serves the PDF in about a second from elsewhere (2026-11-12).
^https://gpbib\.cs\.ucl\.ac\.uk/gecco2005/
