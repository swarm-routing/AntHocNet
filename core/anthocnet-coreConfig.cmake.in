# find_package(anthocnet-core CONFIG REQUIRED): the imported static library
# anthocnet::core, which links swarm::core from an installed swarm-core package.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(swarm-core CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/anthocnet-coreTargets.cmake")
check_required_components(anthocnet-core)
